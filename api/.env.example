# === APP ===
APP_ENV=development
DEBUG=false
APP_NAME=AyeVideoDownloader

# === MONGODB ===
MONGODB_URL=mongodb+srv://AyeVideoDownloaderApp:xHyJCIzzb1qenIdu@ayedevelopmentcluster.xjfqeck.mongodb.net/?appName=AyeDevelopmentCluster
DATABASE_NAME=AyeVideoDownloaderDB

# === AUTH ===
JWT_SECRET_KEY=GENERAR_CON_secrets.token_urlsafe(64)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# === CORS ===
