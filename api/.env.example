# === DOWNLOADS ===
MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_TTL_MINUTES=30
TEMP_DIR=/tmp/ayevideo_downloads
MAX_FILE_SIZE_MB=2048

# === RATE LIMITING ===
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DOWNLOADS=10/minute
